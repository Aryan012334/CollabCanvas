# Database
DATABASE_URL=postgresql://postgres:password@localhost:5433/collabdraw?schema=public

# Authentication
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Redis — WebSocket Pub/Sub fan-out (optional for single-instance local dev)
# Required in production for ws-server to scale beyond 1 replica.
# Run locally: docker run -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379

# Frontend → Backend URLs (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=ws://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment
NODE_ENV=development
